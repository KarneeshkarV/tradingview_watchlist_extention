{
  "manifest_version": 3,
  "name": "TradingView Unlimited Watchlists",
  "version": "0.1.0",
  "description": "Add unlimited custom watchlists to TradingView, stored locally in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.tradingview.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Unlimited Watchlists",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*",
        "https://*.tradingview.com/chart*"
      ],
      "js": [
        "src/lib/watchlist.js",
        "src/lib/storage.js",
        "src/content/tv-bridge.js",
        "src/content/ui.js",
        "src/content/content.js"
      ],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tv-unlimited-watchlists@local",
      "strict_min_version": "121.0"
    }
  }
}
